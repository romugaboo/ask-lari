<%- include('partials/header') %>

    <body class="bg-light">
        <%- include('partials/navbar') %>

            <div class="container mt-4">
                <div class="text-center mb-4">
                    <h1 class="text-primary fw-bold display-4">Ask Lari</h1>
                    <p class="text-muted">Pergunte e compartilhe conhecimento!</p>
                </div>

                <div class="row g-4">
                    <% perguntas.forEach((pergunta)=> { %>
                        <div class="col-4">
                            <div class="card shadow-sm border-0 rounded-5 h-100 p-2">
                                <h4 class="card-body text-dark mb-0">
                                    <%= pergunta.titulo %>
                                </h4>
                                <div class="border-0 text-end p-2">
                                    <a href="/ask/<%= pergunta.id %>" class="btn btn-primary d-flex rounded-pill gap-2">
                                        <i class="bi bi-chat-dots-fill"></i> Responder
                                    </a>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                </div>
            </div>
    </body>

    </html>