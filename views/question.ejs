<%- include('partials/header') %>

    <body class="bg-light">
        <%- include('partials/navbar') %>

            <div class="container p-5">
                <div class="card mb-4 border-0 shadow-sm rounded-5">
                    <div class="card-header rounded-5 border-0 shadow-sm px-4 py-3">
                        <h2 class="text-dark mb-0">
                            <%= pergunta.titulo %>
                        </h2>
                    </div>
                    <div class="card-body">
                        <span class="fs-5">
                            <%= pergunta.descricao %>
                    </div>
                </div>

                <h4 class="text-center m-4">Adicione uma Resposta Pública</h4>
                <form action="/answer-question" method="POST">
                    <input type="hidden" name="pergunta" value="<%= pergunta.id %>">
                    <textarea class="form-control border-0 shadow-sm rounded-5 p-4" name="descricao" id="descricao"
                        rows="6" placeholder="Adicione uma Resposta para esta pergunta..." required></textarea>
                    <button type="submit"
                        class="btn btn-primary mt-3 rounded-pill d-flex gap-2 justify-content-between w-auto ms-auto px-3 py-2">
                        <i class="bi bi-clipboard2-check-fill"></i> Responder
                    </button>
                </form>

                <h4 class="text-center mb-3">Respostas mais recentes</h4>
                <ul class="list-group mb-4">
                    <% if(respostas.length> 0) { %>
                        <% respostas.forEach((resposta)=> { %>
                            <li class="list-group-item border-0 shadow-sm rounded-5 mb-3 p-4">
                                <p>
                                    <%= resposta.descricao %>
                                </p>
                                <p class="text-muted text-end">
                                    <%= resposta.updatedAt %>
                                </p>
                            </li>
                            <% }) %>
                                <% } else { %>
                                    <p class="text-center text-muted">Não há nenhuma resposta para esta pergunta.</p>
                                    <% } %>
                </ul>
            </div>

    </body>

    </html>